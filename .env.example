# =====================================================================
# HoneyComb Text-to-Image Diffusion Studio Configuration
# =====================================================================

# Hugging Face Model Repository
# The repository from which model weights (t2i_weights_v2.h5) are loaded
HF_MODEL_REPO=MasterMAGE/t2i-coco-128-clipL
HF_WEIGHTS_FILE=t2i_weights_v2.h5

# Optional: Hugging Face User Access Token (read permission)
# Only required if the model repository is gated or private.
# Not required for public repositories.
# HF_TOKEN=hf_your_personal_access_token_here

# Architecture Configuration
MODEL_BASE_FILTERS=128
MODEL_TEXT_DIM=768
MODEL_IMAGE_SIZE=128
MODEL_TOKEN_LEN=24
MODEL_TIMESTEPS=1000

# Legacy Keras flag for TensorFlow 2.15+ compatibility
TF_USE_LEGACY_KERAS=1
